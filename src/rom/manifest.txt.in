# name        source                          extinfo
# The archive of docs/spec/01-rom-archive.md, in storage order. RESET is entry
# zero and the table follows it, which is what makes the archive self-locating
# (ARC-4). CMake configures the paths; mkromdir.py resolves them from wherever
# the configured file lands, so they are absolute.
RESET         @PS2_BINARY_DIR@/reset.bin      @@PS2_SOURCE_DIR@/src/rom/extinfo/reset.txt
ROMDIR        =table                          -
EXTINFO       =extinfo                        -
ROMVER        @PS2_BINARY_DIR@/romver.bin     -
RDRAM         @PS2_BINARY_DIR@/rdram.bin      @@PS2_SOURCE_DIR@/src/rom/extinfo/rdram.txt
KERNEL        @PS2_BINARY_DIR@/kernel.bin     @@PS2_SOURCE_DIR@/src/rom/extinfo/kernel.txt
IOPBTCONF     @PS2_SOURCE_DIR@/src/rom/iopbtconf.txt  -
IOPBOOT       @PS2_BINARY_DIR@/iopboot.bin    @@PS2_SOURCE_DIR@/src/rom/extinfo/iopboot.txt
SYSMEM        @PS2_BINARY_DIR@/sysmem.irx     @@PS2_BINARY_DIR@/sysmem.extinfo
LOADCORE      @PS2_BINARY_DIR@/loadcore.irx   @@PS2_BINARY_DIR@/loadcore.extinfo
EXCEPMAN      @PS2_BINARY_DIR@/excepman.irx   @@PS2_BINARY_DIR@/excepman.extinfo
INTRMAN       @PS2_BINARY_DIR@/intrman.irx    @@PS2_BINARY_DIR@/intrman.extinfo
THREADMAN     @PS2_BINARY_DIR@/threadman.irx  @@PS2_BINARY_DIR@/threadman.extinfo
DMACMAN       @PS2_BINARY_DIR@/dmacman.irx    @@PS2_BINARY_DIR@/dmacman.extinfo
IOMAN         @PS2_BINARY_DIR@/ioman.irx      @@PS2_BINARY_DIR@/ioman.extinfo
MODLOAD       @PS2_BINARY_DIR@/modload.irx    @@PS2_BINARY_DIR@/modload.extinfo
ROMDRV        @PS2_BINARY_DIR@/romdrv.irx     @@PS2_BINARY_DIR@/romdrv.extinfo
STDIO         @PS2_BINARY_DIR@/stdio.irx      @@PS2_BINARY_DIR@/stdio.extinfo
EESYNC        @PS2_BINARY_DIR@/eesync.irx     @@PS2_BINARY_DIR@/eesync.extinfo
LOADFILE      @PS2_BINARY_DIR@/loadfile.irx   @@PS2_BINARY_DIR@/loadfile.extinfo
SIO2MAN       @PS2_BINARY_DIR@/sio2man.irx    @@PS2_BINARY_DIR@/sio2man.extinfo
OSDSYS        @PS2_OSDSYS@                    @@PS2_SOURCE_DIR@/src/rom/extinfo/osdsys.txt
